# ──────────────────────────────────────────────
# AWS Polyglot E-Commerce Platform — Environment
# ──────────────────────────────────────────────

# 1. AWS Credentials (for DynamoDB SDK)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# 2. Amazon RDS MySQL
RDS_HOST=your-rds-endpoint.region.rds.amazonaws.com
RDS_PORT=3306
RDS_USER=admin
RDS_PASSWORD=your_rds_password
RDS_DATABASE=ecommerce

# 3. DynamoDB Table Name (optional, defaults to ShoppingCart)
DYNAMO_TABLE=ShoppingCart

# 4. Server Port (optional, defaults to 5000)
SERVER_PORT=5000

# 5. Frontend URL for CORS (optional, defaults to http://localhost:5173)
FRONTEND_URL=http://localhost:5173
